{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pxl-ui",
  "homepage": "https://github.com/pxl-ui/registry",
  "include": [
    "registry/aspect-ratios/pxl/registry.json",
    "registry/backgrounds/pxl/registry.json",
    "registry/colors/pxl/registry.json",
    "registry/fonts/pxl/registry.json",
    "registry/hooks/pxl/registry.json",
    "registry/icons/pxl/registry.json",
    "registry/lib/pxl/registry.json",
    "registry/styles/pxl/registry.json",
    "registry/ui/pxl/registry.json",
    "registry/widgets/pxl/registry.json"
  ],
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "PXL-UI",
      "description": "PXL-UI Base",
      "categories": ["pxl-ui"],
      "extends": "none",
      "config": {
        "style": "pxl-ui"
      },
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "motion"
      ],
      "registryDependencies": [
        "pxl-ui/registry/styles"
      ]
    }
  ]
}
