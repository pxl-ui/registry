{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pxl-ui",
  "homepage": "https://github.com/pxl-ui/registry",
  "include": [
    "registry/colors/registry.json",
    "registry/fonts/registry.json",
    "registry/hooks/registry.json",
    "registry/icons/registry.json",
    "registry/lib/registry.json",
    "registry/styles/registry.json",
    "registry/ui/registry.json",
    "registry/widgets/registry.json"
  ],
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "PXL-UI",
      "description": "PXL-UI Shadcn base",
      "extends": "none",
      "config": {
        "style": "base-lyra",
        "iconLibrary": "lucide",
        "rtl": false,
        "menuColor": "default",
        "menuAccent": "subtle",
        "tailwind": {
          "baseColor": "neutral"
        }
      },
      "registryDependencies": [
        "pxl-ui/registry/styles"
      ]
    }
  ]
}
