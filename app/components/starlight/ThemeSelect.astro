---



import { Button } from "@/components/ui/pxl/button";

import Icon from "./Icon.astro";

---

<starlight-theme-select>
  <Button variant="ghost" size="icon">
		<Icon data-theme-selector="light" name="sun" class="flex" />
		<Icon data-theme-selector="dark" name="moon" class="hidden" />
  </Button> 
</starlight-theme-select>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'dark' || theme === 'light' ? theme : 'light';

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
		}
	}

	function onThemeChange(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme;

    if (theme === "light") {
      (document.querySelector("[data-theme-selector=light]") as SVGElement)?.classList.add("flex");
      (document.querySelector("[data-theme-selector=light]") as SVGElement)?.classList.remove("hidden");
      (document.querySelector("[data-theme-selector=dark]") as SVGElement)?.classList.remove("flex");
      (document.querySelector("[data-theme-selector=dark]") as SVGElement)?.classList.add("hidden");
    } else {
      (document.querySelector("[data-theme-selector=dark]") as SVGElement)?.classList.add("flex");
      (document.querySelector("[data-theme-selector=dark]") as SVGElement)?.classList.remove("hidden");
      (document.querySelector("[data-theme-selector=light]") as SVGElement)?.classList.remove("flex");
      (document.querySelector("[data-theme-selector=light]") as SVGElement)?.classList.add("hidden");
    }

		storeTheme(theme);
	}

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			onThemeChange(loadTheme());
			this.querySelector('button')?.addEventListener('click', (e) => {
        onThemeChange(
          document.documentElement.dataset.theme === "light" ?
            "dark" : "light"
        );
			});
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>