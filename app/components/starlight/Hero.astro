---

import { buttonVariants } from "@/components/ui/pxl/button";
import { url } from "~/lib/utils";

import Icon from "./Icon.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

---
<div class="flex flex-col gap-[clamp(1.5rem,1.5rem+1vw,2rem)] text-center pb-4 md:py-[clamp(2.5rem,1rem+10vmin,10rem)]">
  <div class="flex flex-col gap-4 items-center">
    <h1 class="text-foreground font-heading text-3xl">{title}</h1>
    <p class="text-base sm:text-lg leading-5">
      {tagline}
    </p>
  </div>

  {actions.length > 0 && (<div class="flex flex-wrap gap-[1rem_2rem] justify-center">
    {actions.map(
      ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
        <a
          href={url(href)}
          class={buttonVariants({ variant })}
          {...attrs}>
          {text}
          {icon && (
            icon?.html ? <Fragment set:html={icon.html} /> : (icon.name && (<Icon name={icon.name} />))
          )}
        </a>
      )
    )}
  </div>)}
</div>