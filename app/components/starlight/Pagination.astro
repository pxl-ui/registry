---

import { buttonVariants } from '@/components/ui/pxl/button';

import Icon from './Icon.astro';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

<div class="h-16 hidden w-full sm:flex flex-row items-center justify-between print:hidden mb-8" dir={dir}>
	{prev ? (
    <a href={prev.href} 
      rel="prev"
      class={buttonVariants({
        size: "sm",
        variant: "secondary",
      })}>
      <Icon name="left-arrow" />
      {prev.label}
    </a>
  ) : <p></p>}
	{next && (
    <a href={next.href} 
      rel="next"
      class={buttonVariants({
        size: "sm",
        variant: "secondary",
      })}>
        {next.label}
        <Icon name="right-arrow" />
    </a>
  )}
</div>