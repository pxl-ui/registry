---

import { Button } from '@/components/ui/pxl/button';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

<div class="w-full flex flex-row justify-between print:hidden" dir={dir}>
	{prev ? (
    <a href={prev.href} rel="prev">
      <Button size="sm" variant="secondary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M20 11v2H4v-2zM8 13v2H6v-2zm2 2v2H8v-2zm2 2v2h-2v-2zm-4-6V9H6v2z"/><path d="M10 15V7H8v8zm2 2V5h-2v12z"/></svg>
        {prev.label}
      </Button>
    </a>
  ) : <p></p>}
	{next && (
    <a href={next.href} rel="next">
      <Button size="sm" variant="secondary">
        {next.label}
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M4 11v2h16v-2zm12 2v2h2v-2zm-2 2v2h2v-2zm-2 2v2h2v-2zm4-6V9h2v2z"/><path d="M14 15V7h2v8zm-2 2V5h2v12z"/></svg>
      </Button>
    </a>
  )}
</div>