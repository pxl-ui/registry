---

import { buttonVariants } from '@/components/ui/pxl/button';
import { fromRouteId, pages } from '~/lib/registry';

import Icon from './Icon.astro';

const item = fromRouteId(Astro.locals.starlightRoute.id); 

let { dir, pagination } = Astro.locals.starlightRoute;

if (item?.name && !pagination.prev && !pagination.next) {
  pagination = pages(item.name);
}

const { prev, next } = pagination;
---

<div class="h-16 hidden w-full sm:flex flex-row items-center justify-between print:hidden mb-8" dir={dir}>
	{prev ? (
    <a href={prev.href} 
      rel="prev"
      class={buttonVariants({
        size: "sm",
        variant: "secondary",
      })}>
      <Icon name="left-arrow" />
      {prev.label}
    </a>
  ) : <p></p>}
	{next && (
    <a href={next.href} 
      rel="next"
      class={buttonVariants({
        size: "sm",
        variant: "secondary",
      })}>
        {next.label}
        <Icon name="right-arrow" />
    </a>
  )}
</div>