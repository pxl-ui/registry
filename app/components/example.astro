---

import { cardVariants } from '@/components/ui/pxl/card';
import { cn } from '@/lib/utils';
import examples from "~/lib/examples";

import Code from './Code.astro';
import ExampleRenderer from './ExampleRenderer';

export type Props = {
	align?: "center" | "start" | "end";
	chromeless?: boolean;
	src?: string;
	code?: string;
	lang?: string;
	class?: string;
	style?: string | astroHTML.JSX.CSSProperties | null | undefined;
	collapsedHeight?: number;
}

const { align, chromeless, src, code, lang = "tsx", class: className, style, collapsedHeight = 120 } = Astro.props;

let sourceCode = code;

if (src && !code) {
	sourceCode = examples.sources.get(src);
}
---

<div
	class={cn(
		"not-content",
		cardVariants(),
		"pixel-color-border! bg-background! mt-4 mb-12",
		className
	)}
	style={style}
>
	<div
		data-slot="card-content"
		class={cn("flex-1 min-h-0", className)}
	>
		<div 
			data-align={align}
			data-chromeless={chromeless}
			class={cn(
				"relative flex min-h-72 w-full justify-center p-10 data-[align=center]:items-center data-[align=end]:items-start data-[align=start]:items-start data-[chromeless=true]:h-auto data-[chromeless=true]:p-0 sm:data-[align=end]:items-end",
			)}>
			{src ? <ExampleRenderer src={src} client:load /> : <slot />}
		</div>

		{sourceCode && <Code class="relative border-t-4 border-border" code={sourceCode} lang={lang} collapsed />}
	</div>
</div>