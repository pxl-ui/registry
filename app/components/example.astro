---

import { Code } from '@astrojs/starlight/components';

import { cn } from '@/lib/utils';

export type Props = {
	code?: string;
	lang?: string;
	class?: string;
	style?: string | astroHTML.JSX.CSSProperties | null | undefined;
	collapsedHeight?: number;
}

const { code, lang = "tsx", class: className, style, collapsedHeight = 120 } = Astro.props;
---

<div
	class={cn(
		"pixel-border pixel-color-muted-foreground bg-muted pixel-size-lg p-4 not-content",
		className
	)}
	style={style}
>
	<slot />

	{code && (
		<div class="code-preview relative mt-4" data-collapsed-height={collapsedHeight}>
			<div
				class="code-preview-content overflow-hidden transition-[max-height] duration-300 ease-in-out"
				style={`max-height: ${collapsedHeight}px`}
			>
				<Code code={code} lang={lang}  />
			</div>

			<div class="code-preview-fade pointer-events-none absolute inset-x-0 bottom-9 h-16 bg-linear-to-t from-muted to-transparent transition-opacity duration-300" />

			<div class="code-preview-toggle-wrapper relative flex justify-center pt-2">
				<button
					type="button"
					class="code-preview-toggle pixel-border pixel-color-muted-foreground pixel-size-sm bg-background px-3 py-1.5 text-xs font-medium hover:bg-accent transition-colors"
					data-state="collapsed"
				>
					View code
				</button>
			</div>
		</div>
	)}
</div>

<script>
	function initCodePreviews(root: ParentNode = document) {
		root.querySelectorAll<HTMLElement>('.code-preview:not([data-init])').forEach((wrapper) => {
			wrapper.dataset.init = "true";

			const content = wrapper.querySelector<HTMLElement>('.code-preview-content');
			const fade = wrapper.querySelector<HTMLElement>('.code-preview-fade');
			const toggleWrapper = wrapper.querySelector<HTMLElement>('.code-preview-toggle-wrapper');
			const button = wrapper.querySelector<HTMLButtonElement>('.code-preview-toggle');
			if (!content || !button) return;

			const collapsedHeight = Number(wrapper.dataset.collapsedHeight ?? 240);

			if (content.scrollHeight <= collapsedHeight) {
				content.style.maxHeight = "none";
				fade?.remove();
				toggleWrapper?.remove();
				return;
			}

			button.addEventListener('click', () => {
				const collapsed = button.dataset.state === 'collapsed';

				content.style.maxHeight = collapsed ? `400px` : `${collapsedHeight}px`;
				content?.classList.toggle('overflow-hidden', !collapsed);
				content?.classList.toggle('overflow-auto', collapsed);
				fade?.classList.toggle('opacity-0', collapsed);
				button.dataset.state = collapsed ? 'expanded' : 'collapsed';
				button.textContent = collapsed ? 'Hide code' : 'View code';
			});
		});
	}

	initCodePreviews();
	document.addEventListener('astro:page-load', () => initCodePreviews());
</script>