---





import { Button } from '@/components/ui/pxl/button';

import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
---

<footer class="flex flex-col gap-6">
	<div class="meta flex gap-[0.75rem_3rem] justify-between flex-wrap mt-12 text-sm text-muted">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />


  {Astro.locals.starlightRoute.id === "" && <p class="bottom-0 items-center my-6 mx-auto text-xs text-muted-foreground hover:text-foreground self-center-safe">
    Built by <a href="https://aitorllamas.com"><Button className="p-0 h-auto" variant="link">aitorllj93</Button></a> at <a href="https://github.com/gotchu-creatures"><Button className="p-0 h-auto" variant="link">Gotchu Creatures</Button></a>. The source code is available on <a href="https://github.com/pxl-ui/registry"><Button className="p-0 h-auto" variant="link">GitHub</Button></a>.
  </p>}
</footer>

<style>
	@layer starlight.core {
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}
	}
</style>
