---
import { Code } from '@astrojs/starlight/components';

import { buttonVariants } from '@/components/ui/pxl/button';

export type Props = {
	class?: string;
	code: string;
  collapsed?: boolean;
	collapsedHeight?: number;
	lang?: string;
	title?: string;
}

const { class: className, code, collapsed, lang = "tsx", collapsedHeight = 110 , title} = Astro.props;

---
{!collapsed && (
  <Code 
		title={title}
		code={code} 
		lang={lang}
		showLineNumbers />
)}

{collapsed && (
  <div 
    data-slot="code-preview"
    data-collapsed-height={collapsedHeight}
    class={className}>
    <div
      data-slot="code-preview-content"
      class="overflow-hidden scrollbar-none transition-[max-height] duration-300 ease-in-out"
      style={`max-height: ${collapsedHeight}px`}
    >
      <Code 
				title={title}
				code={code} 
				lang={lang} 
				showLineNumbers  />
    </div>

    <div 
      data-slot="code-preview-fade"
      class="pointer-events-none absolute inset-x-0 bottom-0 transition-opacity duration-300"
			style={`height: ${collapsedHeight}px; background:linear-gradient(to top, var(--ec-frm-edBg), color-mix(in oklab, var(--ec-frm-edBg) 60%, transparent), transparent)`} />

    <div
      data-slot="code-preview-toggle-wrapper" 
      class="absolute inset-x-0 flex justify-center pt-2 transition-all"
			style={`bottom: ${(collapsedHeight / 2) - 14}px`}>
      <button
        type="button"
        data-slot="code-preview-toggle"
        data-state="collapsed"
				class={buttonVariants({
					size: "sm",
					variant: "outline"
				})}
      >
        View code
      </button>
    </div>
  </div>
)}


<script>
	function initCodePreviews(root: ParentNode = document) {
		root.querySelectorAll<HTMLElement>('[data-slot=code-preview]:not([data-init])').forEach((wrapper) => {
			wrapper.dataset.init = "true";

			const content = wrapper.querySelector<HTMLElement>('[data-slot=code-preview-content]');
			const fade = wrapper.querySelector<HTMLElement>('[data-slot=code-preview-fade]');
			const toggleWrapper = wrapper.querySelector<HTMLElement>('[data-slot=code-preview-toggle-wrapper]');
			const button = wrapper.querySelector<HTMLButtonElement>('[data-slot=code-preview-toggle]');
			if (!content || !button) return;

			const collapsedHeight = Number(wrapper.dataset.collapsedHeight ?? 240);

			if (content.scrollHeight && content.scrollHeight <= collapsedHeight) {
				content.style.maxHeight = "none";
				fade?.remove();
				toggleWrapper?.remove();
				return;
			}

			button.addEventListener('click', () => {
				const collapsed = button.dataset.state === 'collapsed';

				content.style.maxHeight = collapsed ? `400px` : `${collapsedHeight}px`;
				content?.classList.toggle('overflow-hidden', !collapsed);
				content?.classList.toggle('overflow-auto', collapsed);
				fade?.classList.toggle('opacity-0', collapsed);
				button.dataset.state = collapsed ? 'expanded' : 'collapsed';
				button.textContent = collapsed ? 'Hide code' : 'View code';
				toggleWrapper!.style.bottom = collapsed ? "14px" : `${(collapsedHeight / 2) - 14}px`;
				if (collapsed) {
					toggleWrapper!.style.display = "none";
				}
			});
		});
	}

	initCodePreviews();
	document.addEventListener('astro:page-load', () => initCodePreviews());
</script>