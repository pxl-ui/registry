---

import { Code } from '@astrojs/starlight/components';

import { Button } from '@/components/ui/pxl/button';

export type Props = {
	class?: string;
	code: string;
  collapsed?: boolean;
	collapsedHeight?: number;
	lang?: string;
}

const { class: className, code, collapsed, lang = "tsx", collapsedHeight = 120 } = Astro.props;

---
{!collapsed && (
  <Code code={code} lang={lang}  />
)}

{collapsed && (
  <div 
    data-slot="code-preview"
    data-collapsed-height={collapsedHeight}
    class={className}>
    <div
      data-slot="code-preview-content"
      class="overflow-hidden transition-[max-height] duration-300 ease-in-out"
      style={`max-height: ${collapsedHeight}px`}
    >
      <Code code={code} lang={lang}  />
    </div>

    <div 
      data-slot="code-preview-fade"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-linear-to-t from-(--ec-frm-edBg) to-transparent transition-opacity duration-300" />

    <div
      data-slot="code-preview-toggle-wrapper" 
      class="absolute inset-x-0 bottom-9 flex justify-center pt-2">
      <button
        type="button"
        data-slot="code-preview-toggle"
        data-state="collapsed"
        class="group/button shrink-0 bg-clip-padding font-medium whitespace-nowrap outline-none select-none focus-visible:border-ring focus-visible:ring-1 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-1 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='fill-'])]:fill-current [&_svg:not([class*='size-'])]:size-4 pixel-border pixel-rounded pixel-size-md pixel-color-border bg-background hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:border-input dark:pixel-color-input dark:bg-input/30 dark:hover:bg-input/50 h-9 gap-1.5 px-2.5 text-lg has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 rounded-none active:translate-y-1 transition-transform relative inline-flex items-center justify-center border-none"
      >
        View code
      </button>
    </div>
  </div>
)}


<script>
	function initCodePreviews(root: ParentNode = document) {
		root.querySelectorAll<HTMLElement>('[data-slot=code-preview]:not([data-init])').forEach((wrapper) => {
			wrapper.dataset.init = "true";

			const content = wrapper.querySelector<HTMLElement>('[data-slot=code-preview-content]');
			const fade = wrapper.querySelector<HTMLElement>('[data-slot=code-preview-fade]');
			const toggleWrapper = wrapper.querySelector<HTMLElement>('[data-slot=code-preview-toggle-wrapper]');
			const button = wrapper.querySelector<HTMLButtonElement>('[data-slot=code-preview-toggle]');
			if (!content || !button) return;

			const collapsedHeight = Number(wrapper.dataset.collapsedHeight ?? 240);

			if (content.scrollHeight <= collapsedHeight) {
				content.style.maxHeight = "none";
				fade?.remove();
				toggleWrapper?.remove();
				return;
			}

			button.addEventListener('click', () => {
				const collapsed = button.dataset.state === 'collapsed';

				content.style.maxHeight = collapsed ? `400px` : `${collapsedHeight}px`;
				content?.classList.toggle('overflow-hidden', !collapsed);
				content?.classList.toggle('overflow-auto', collapsed);
				fade?.classList.toggle('opacity-0', collapsed);
				button.dataset.state = collapsed ? 'expanded' : 'collapsed';
				button.textContent = collapsed ? 'Hide code' : 'View code';
			});
		});
	}

	initCodePreviews();
	document.addEventListener('astro:page-load', () => initCodePreviews());
</script>