---

import type { ComponentProps } from 'react';

import { Callout as PxlCallout } from '@/components/ui/pxl/callout';
import { cn } from '@/lib/utils';

export type Props = ComponentProps<typeof PxlCallout>;

const { className, ...props } = Astro.props;

---
<PxlCallout className={cn("not-content", className)} {...props} >
  <slot />
</PxlCallout>