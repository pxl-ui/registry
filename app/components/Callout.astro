---

import { Callout as PxlCallout } from '@/components/ui/pxl/callout';

export type Props = {
  title?: string;
  type?: "caution" | "note" | "tip" | "danger" | undefined
}

const { title: titleOverride, type } = Astro.props;

let title = "";

title = titleOverride ?? title;

---
<PxlCallout className="not-content" type={type}>
  <slot />
</PxlCallout>