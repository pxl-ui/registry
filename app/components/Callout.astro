---

import type { VariantProps } from 'class-variance-authority';

import { cardVariants } from '@/components/ui/pxl/card';
import { cn } from '@/lib/utils';


export type Props = {
  title?: string;
  type?: "caution" | "note" | "tip" | "danger" | undefined
}

const { title: titleOverride, type } = Astro.props;

let title = "";
let variant: VariantProps<typeof cardVariants>["variant"] = "muted";

if (type === "caution") {
  title = Astro.locals.t("aside.caution");
  variant = "warning";
}

if (type === "danger") {
  title = Astro.locals.t("aside.danger");
  variant = "danger";
}

if (type === "note") {
  title = Astro.locals.t("aside.note");
  variant = "primary";
}

if (type === "tip") {
  title = Astro.locals.t("aside.tip");
  variant = "info";
}

title = titleOverride ?? title;

---
<div class={cn(cardVariants({ variant, className: "not-content pixel-size-lg p-4" }), "pixel-color-[transparent]!")}>
  {title && (
    <div data-slot="card-header"
      class="group/card-header mb-2">
      <div data-slot="card-title"
        class="flex gap-2 items-center font-sans text-sm font-bold [&_svg]:fill-current [&_svg]:size-4"
      >
        {!type && (<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M18 22H6V20H18V22ZM6 20H4V18H6V20ZM20 20H18V18H20V20ZM4 18H2V6H4V18ZM22 18H20V6H22V18ZM13 17H11V11H13V17ZM13 9H11V7H13V9ZM6 6H4V4H6V6ZM20 6H18V4H20V6ZM18 4H6V2H18V4Z"></path></svg>)}
        {type === "note" && (<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M18 22H6V20H18V22ZM6 20H4V18H6V20ZM20 20H18V18H20V20ZM4 18H2V6H4V18ZM22 18H20V6H22V18ZM13 17H11V11H13V17ZM13 9H11V7H13V9ZM6 6H4V4H6V6ZM20 6H18V4H20V6ZM18 4H6V2H18V4Z"></path></svg>)}
        {type === "caution" && (<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M14 22h-4v-2h4v2Zm-4-2H8v-2h2v2Zm6 0h-2v-2h2v2Zm-8-2H6v-2h2v2Zm10 0h-2v-2h2v2Zm-5-1h-2v-2h2v2Zm-7-1H4v-2h2v2Zm14 0h-2v-2h2v2ZM4 14H2v-4h2v4Zm18 0h-2v-4h2v4Zm-9-7v6h-2V7h2Zm-7 3H4V8h2v2Zm14 0h-2V8h2v2ZM8 8H6V6h2v2Zm10 0h-2V6h2v2Zm-8-2H8V4h2v2Zm6 0h-2V4h2v2Zm-2-2h-4V2h4v2Z"></path></svg>)}
        {type === "danger" && (<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M4 13h8v6h2v2h-2v2h-2v-8H2v-4h2v2Zm12 6h-2v-2h2v2Zm2-2h-2v-2h2v2Zm2-2h-2v-2h2v2Zm-6-6h8v4h-2v-2h-8V5h-2V3h2V1h2v8Zm-8 2H4V9h2v2Zm2-2H6V7h2v2Zm2-2H8V5h2v2Z"></path></svg>)}
        {type === "tip" && (<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M16 22H8v-2h8v2Zm-8-2H6v-2h2v2Zm10 0h-2v-2h2v2ZM6 18H4v-6h2v6Zm14 0h-2v-8h2v8Zm-10-4H8v-2h2v2Zm-2-2H6V8h2v4Zm4-8h2v2h-2v6h-2V2h2v2Zm6 6h-2V8h2v2Zm-2-2h-2V6h2v2Z"></path></svg>)}
        {title}
      </div>
    </div>
  )}
  <div
    data-slot="card-content"
    class="flex-1 min-h-0"
  >
    <slot />
  </div>
</div>