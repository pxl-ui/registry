---

import type { ComponentProps } from 'react';

import { type CalloutVariant, Callout as PxlCallout } from '@/components/ui/pxl/callout';
import { cn } from '@/lib/utils';

export type Props = ComponentProps<typeof PxlCallout> & {
  type?: CalloutVariant
};

const { className, type: variant, ...props } = Astro.props;

---
<PxlCallout 
  className={cn("not-content", className)} 
  variant={variant}
  {...props} >
  <slot />
</PxlCallout>