---

import { cn } from '@/lib/utils';

export type Props = {
  class?: string;
  lowercase?: boolean;
}

const { class: className, lowercase = true } = Astro.props;

// let sample = "AaBbCcDdEeFfGgHhIiJjKkLlMmÑnOoPpQqRrSsTtUuVvWwXxYyZz";
let sample = "Aa";

if (lowercase === false) {
  sample = [...sample]
    .filter((_, i) => i % 2 !== 0)
    .join("");
}

---
<span class={cn("not-italic text-sm text-muted-foreground", className)}>
  {sample}
</span>