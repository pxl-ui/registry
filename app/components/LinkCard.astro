---

import type { HTMLAttributes } from 'astro/types';

import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/pxl/card';

import Icon from './starlight/Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'title'> {
	title: string;
	description?: string;
}

const { title, description, ...attributes } = Astro.props;
---
<a {...attributes}>
  <Card className="cursor-pointer pixel-color-border! hover:pixel-color-foreground!">
    <CardHeader className="flex justify-between">
      <CardTitle className="h-auto flex gap-2 items-center leading-5! text-sm! mr-4 truncate">
        <slot name="media" />
        <span class="truncate">{title}</span>
      </CardTitle>
      <Icon name="right-arrow"
        class="icon rtl:flip size-[1.333em] shrink-0 text-muted-foreground group-hover/card:text-foreground" />
    </CardHeader>
    <CardContent>
  		<p class="line-clamp-1 text-muted-foreground text-2xs" set:html={description ?? "&nbsp;"} />
    </CardContent>
  </Card>
</a>