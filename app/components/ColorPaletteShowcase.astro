---



import { formatColor, parse } from "gimp-palette";

import { cardVariants } from "@/components/ui/pxl/card";
import { cn } from "@/lib/utils";
import { registryItemFromRouteId } from "~/lib/utils";

export type Props = {
  palette: string;
};

const itemName = registryItemFromRouteId(Astro.locals.starlightRoute.id); 

const { palette } = Astro.props;

const { colors, name } = parse(palette);

---
<div class={cn(
  "not-content",
  cardVariants(),
  "pixel-color-border!",
)}>
	<div
		data-slot="card-content"
		class={cn("flex-1 h-72 max-h-72 scrollbar-thin scrollbar-thumb-border overflow-auto p-(--card-spacing)")}>
    <div class={cn("flex flex-col gap-2", itemName)}>
      {colors.map(c => (
        <div class="flex flex-col sm:flex-row gap-2 items-center">
          <h2 class="font-sans text-sm sm:w-30">{c.name}</h2>
          <p style={{
            backgroundColor: formatColor(c, "oklch"), // We need to force the color because this classes are only available on run time
          }} class={cn("w-full h-10", `bg-pico-${c.name}`)}></p>
        </div>
      ))}
    </div>
  </div>
</div>