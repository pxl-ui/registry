---


import { cn } from '@/lib/utils';


const SIZES = {
  "3xs": "text-3xs",
  "2xs": "text-2xs",
  "xs": "text-xs",
  "sm": "text-sm",
  "base": "text-base",
  "lg": "text-lg",
  "xl": "text-xl",
  "2xl": "text-2xl",
  "3xl": "text-3xl",
  "4xl": "text-4xl",
  "5xl": "text-5xl",
  "6xl": "text-6xl",
  "7xl": "text-7xl",
  "8xl": "text-8xl",
  "9xl": "text-9xl",
}

export type Props = {
  class?: string;
}

const { class: className } = Astro.props;
---
<div class="not-content space-y-2">
{
  Object.entries(SIZES).map(([label, value]) => (
    <div class="flex flex-col sm:flex-row gap-2 items-center">
      <h2 class="font-heading sm:w-12">{label}</h2>
      <p class={cn("flex-1 truncate", value, className)}>The quick brown fox jumps over the lazy dog</p>
    </div>
  ))
}
</div>