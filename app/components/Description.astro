---

import registry from "~/lib/registry";
import { registryItemFromRouteId } from "~/lib/utils";

export type Props = {
  item?: string;
}

const { item: name } = Astro.props;

let itemName: string | null = name ?? null;

if (!itemName) {
 itemName = registryItemFromRouteId(Astro.locals.starlightRoute.id); 
}

const item = itemName ? registry.get(itemName) : null;

---
{item?.description && <p>{item.description}</p>}
