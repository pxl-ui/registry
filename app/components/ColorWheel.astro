---

import { formatColor, parse } from "gimp-palette";

export type Props = {
  palette: string;
};

const { palette } = Astro.props;

const { colors, name } = parse(palette);

function getGradient() {
  if (!colors.length) {
    return "transparent";
  }

  const step = 100 / colors.length;

  return `conic-gradient(${colors
    .map((color, index) => {
      const start = index * step;
      const end = (index + 1) * step;

      return `${formatColor(color, "rgb")} ${start}% ${end}%`;
    })
    .join(", ")})`;
}

const gradient = getGradient();
---
<div class="relative size-8 aspect-square">
  <div
    class="absolute inset-0 size-full  pixel-rounded pixel-size-lg"
    style={{
      background: gradient,
    }}
  ></div>
</div>