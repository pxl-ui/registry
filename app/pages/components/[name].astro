---



import BottomNavigation from "@/app/layouts/BottomNavigation.astro";
import Layout from "@/app/layouts/Layout.astro";
import { OpenInV0Button } from "@/components/open-in-v0-button";
import { RegistryCommand } from "@/components/registry-command";
import { RegistryPreview } from "@/components/registry-preview";
import { ShowSourceButton } from "@/components/show-source-button";
import { registry } from "@/lib/registry";

const REGISTRY_URL = "pxl-ui/registry";
const REPOSITORY_URL = `https://github.com/${REGISTRY_URL}`;

export function getStaticPaths() {
  return registry.map(({ name }) => ({ params: { name } }));
}

const { name } = Astro.params;
const entry = registry.find(e => e.name === name);

const exampleFilePath = `/registry/pxl-ui/${name}/examples/${name}.tsx`;

if (!entry) {
  return Astro.redirect("/404");
}

const index = registry.findIndex(r => r.name === name);

const prev = {
  label: index === 0 ? "Components" : (registry[index - 1].title ?? registry[index - 1].name),
  href: index === 0 ? "/registry/components" : `/registry/components/${registry[index - 1].name}`
}

const next = registry.length === index + 1 ? undefined : {
  label: (registry[index + 1].title ?? registry[index + 1].name),
  href: `/registry/components/${registry[index + 1].name}`,
}

---

<Layout>
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="h-(--top-spacing) shrink-0">
    </div>
    <div
      class="mx-auto flex w-full max-w-3xl min-w-0 flex-1 flex-col gap-6 px-4 py-6 text-neutral-800 md:px-0 lg:py-8 dark:text-neutral-300">
      <div class="flex flex-col gap-2">
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between md:items-start">
            <h1 class="scroll-m-24 text-3xl font-semibold tracking-tight sm:text-3xl">{entry.title ?? entry.name}</h1>
          </div>
          <p class="text-[1.05rem] text-muted-foreground sm:text-base sm:text-balance md:max-w-[80%]">
            {entry.description}
          </p>
        </div>
      </div>
      <div class="prose flex-1">
        <div
          class="flex flex-col items-center justify-center relative border rounded-lg p-4"
          style={{ minHeight: "400px" }}
        >
          <RegistryPreview
            filePath={exampleFilePath}
            client:visible
          />
        </div>
        <div>
          <RegistryCommand client:visible registryId="pxl-ui/registry" registryComponent={entry.name} />
        </div>
      </div>
      <BottomNavigation 
        prev={prev}
        next={next}
      />
    </div>
  </div>
</Layout>