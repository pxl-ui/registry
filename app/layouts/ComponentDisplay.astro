---

export type Props = {
  name: string;
  description: string;
  minHeight?: string;
  filePath: string;
  component?: React.ComponentType;
};

const {
  name,
  description,
  minHeight = "400px",
  filePath,
  component: Component,
} = Astro.props;
---
<div class="flex flex-col gap-4 border rounded-lg p-4 min-h-112.5 relative">
  <div class="flex items-center justify-between">
    <div class="flex flex-col gap-2">
      <h2 class="text-sm text-muted-foreground sm:pl-3">{name}</h2>
      <p class="text-xs text-muted-foreground sm:pl-3">{description}</p>
    </div>
    <div class="flex gap-2">
      <!-- <ShowSourceButton filePath={filePath} />
      <OpenInV0Button name={name} /> -->
    </div>
  </div>
  <div
    class={`flex flex-col items-center justify-center min-h-[${minHeight}] relative`}
  >
    {Component && <Component client:load />}
    <slot />
  </div>
</div>