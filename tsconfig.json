{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/components/ui/pxl-ui/*": ["./registry/pxl-ui/*"],
      "~/*": ["./app/*"],
      "@/*": ["./*"]
    }
  }
}