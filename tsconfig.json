{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/examples/*": ["./examples/*"],
      "~/*": ["./app/*"],
      "@/components/backgrounds/*": ["./registry/backgrounds/*"],
      "@/components/colors/*": ["./registry/colors/*"],
      "@/components/fonts/*": ["./registry/fonts/*"],
      "@/components/icons/*": ["./registry/icons/*"],
      "@/components/styles/*": ["./registry/styles/*"],
      "@/components/ui/*": ["./registry/ui/*"],
      "@/components/widgets/*": ["./registry/widgets/*"],
      "@/hooks/*": ["./registry/hooks/*"],
      "@/lib/*": ["./registry/lib/*"],
      "@/*": ["./registry/*"],
    }
  }
}