{ 
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pxl-ui/spec",
  "title": "Spec",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The name of the spec"
    },
    "description": {
      "type": "string",
      "description": "The description of the spec"
    },
    "version": {
      "type": "string",
      "description": "The version of the spec"
    },
    "author": {
      "type": "string",
      "description": "The author of the spec"
    },
    "url": {
      "type": "string",
      "description": "The url of the spec"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [{ "type": "string"}, { "type": "number" }],
            "description": "The unique identifier of the entry"
          },
          "title": {
            "type": "string",
            "description": "The name of the entry"
          },
          "description": {
            "type": "string",
            "description": "The description of the entry"
          }
        },
        "required": ["id"]
      }
    }
  },
  "required": ["title"]
}
