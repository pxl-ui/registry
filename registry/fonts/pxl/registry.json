      "title": "Able 5",
      "description": "A tiny font that supports hundreds of languages!",
      "docs": "Download font from https://stormgold.itch.io/able-font",
      "author": "stormgold <https://stormgold.itch.io/>",
      "categories": ["pxl-ui", "font-family", "font-text"],
      "files": [
        {
          "type": "registry:style",
          "path": "able-5.css",
          "target": "@components/fonts/pxl/able-5.css"
        }
      ],
      "css": {
        "@import \"@/components/fonts/pxl/able-5.css\"": {}
      },
      "cssVars": {
        "theme": {
          "font-able-5": "'Able 5', sans-serif"
        }
      }
    },
