{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pxl/features/library",
  "homepage": "https://github.com/pxl-ui/registry",
  "items": [
    {
      "name": "library/book",
      "type": "registry:component",
      "title": "Book",
      "description": "A component for displaying a book",
      "categories": ["pxl-ui", "features", "library"],
      "dependencies": ["cn", "class-variance-authority", "motion"],
      "files": [
        { 
          "type": "registry:file",
          "path": "book.tsx",
          "target": "@components/features/pxl/library/book.tsx"
        }
      ]
    },
    {
      "name": "library/opds/book",
      "type": "registry:component",
