      "categories": ["pxl-ui", "features", "library", "library/opds"],
      "registryDependencies": [
        "pxl-ui/registry/library/book",
        "pxl-ui/registry/schemas/opds"
      ],
      "files": [
        { 
          "type": "registry:file",
          "path": "opds/book.tsx",
          "target": "@components/features/pxl/library/opds/book.tsx"
        }
      ]
    },
    {
      "name": "library/opds-1.2/book",
      "type": "registry:component",
      "title": "OPDS 1.2 Book",
      "description": "A component for displaying a book from OPDS catalog",
      "categories": ["pxl-ui", "features", "library", "library/opds"],
      "registryDependencies": [
        "pxl-ui/registry/library/book",
        "pxl-ui/registry/schemas/opds"
      ],
      "files": [
        { 
          "type": "registry:file",
          "path": "opds-1.2/book.tsx",
          "target": "@components/features/pxl/library/opds-1.2/book.tsx"
        }
      ]
    },
    {
      "name": "library/shelf",
      "type": "registry:component",
      "title": "Shelf",
      "description": "A component for displaying a shelf",
      "categories": ["pxl-ui", "features", "library"],
      "dependencies": ["cn"],
      "files": [
        { 
          "type": "registry:file",
          "path": "shelf.tsx",
          "target": "@components/features/pxl/library/shelf.tsx"
        }
      ]
    }
  ]
}
