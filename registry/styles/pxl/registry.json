{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pxl/styles",
  "homepage": "https://github.com/pxl-ui/registry",
  "items": [
    {
      "name": "styles/animations",
      "type": "registry:style",
      "title": "Animation Styles",
      "description": "Keyframe based CSS animations",
      "categories": ["pxl-ui", "styles", "animations"],
      "files": [
        {
          "type": "registry:file",
          "path": "animations.css",
          "target": "@components/styles/pxl/animations.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/animations.css\"": {}
      },
      "cssVars": {
        "theme": {
          "animate-blink": "blink var(--tw-duration, 1s) steps(1) infinite",
          "animate-marquee": "marquee var(--tw-duration, 6s) ease-in-out infinite alternate",
          "animate-shine": "shine var(--tw-duration, 1s) ease-in-out infinite"
        }
      }
    },
    {
      "name": "styles/cursors",
      "type": "registry:style",
      "title": "Mouse Cursors",
      "description": "Custom mouse cursor utilities",
      "categories": ["pxl-ui", "styles", "mouse-cursors"],
      "files": [
        {
          "type": "registry:file",
          "path": "cursors.css",
          "target": "@components/styles/pxl/cursors.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/cursors.css\"": {}
      }
    },
    {
      "name": "styles/filters",
      "type": "registry:style",
      "title": "Screen Filters Styles",
      "description": "Custom screen filter styles",
      "categories": ["pxl-ui", "styles", "screen-filters"],
      "files": [
        {
          "type": "registry:file",
          "path": "filters.css",
          "target": "@components/styles/pxl/filters.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/filters.css\"": {}
      }
    },
    {
      "name": "styles/keyboard",
      "type": "registry:style",
      "title": "Keyboard Styles",
      "description": "Custom keyboard styles",
      "categories": ["pxl-ui", "styles", "keyboard"],
      "files": [
        {
          "type": "registry:file",
          "path": "keyboard.css",
          "target": "@components/styles/pxl/keyboard.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/keyboard.css\"": {}
      }
    },
    {
      "name": "styles/pixels",
      "type": "registry:style",
      "title": "Pixel Styles",
      "description": "Custom pixel-based text and border styles",
      "categories": ["pxl-ui", "styles", "pixels"],
      "files": [
        {
          "type": "registry:file",
          "path": "pixels.css",
          "target": "@components/styles/pxl/pixels.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/pixels.css\"": {}
      },
      "cssVars": {
        "theme": {
          "pixel-size-xs": "0.5px",
          "pixel-size-sm": "1px",
          "pixel-size-md": "2px",
          "pixel-size-lg": "4px"
        }
      }
    },
    {
      "name": "styles/sprites",
      "type": "registry:style",
      "title": "Sprite Styles",
      "description": "Sprite rendering utilities",
      "categories": ["pxl-ui", "styles", "sprite-sheet", "animations"],
      "files": [
        {
          "type": "registry:file",
          "path": "sprites.css",
          "target": "@components/styles/pxl/sprites.css"
        },
        {
          "type": "registry:file",
          "path": "sprite-animate.js",
          "target": "@components/styles/pxl/sprite-animate.js"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/sprites.css\"": {}
      }
    },
    {
      "name": "styles/texts",
      "type": "registry:style",
      "title": "Text Sizes",
      "description": "Text sizing override utilities",
      "files": [
        {
          "type": "registry:file",
          "path": "texts.css",
          "target": "@components/styles/pxl/texts.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/texts.css\"": {}
      },
      "cssVars": {
        "theme": {
          "text-3xs": "0.5rem",
          "text-2xs": "0.625rem"
        }
      }
    },
    {
      "name": "styles/typeset",
      "type": "registry:style",
      "title": "Typeset",
      "description": "A styling system for HTML and rendered markdown, from blog posts to streaming chat. One CSS file you own.",
      "files": [
        {
          "type": "registry:file",
          "path": "typeset.css",
          "target": "@components/styles/pxl/typeset.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/typeset.css\"": {}
      }
    },
    {
      "name": "styles/widgets",
      "type": "registry:style",
      "title": "Widget Sizes",
      "description": "Widget sizing utilities",
      "files": [
        {
          "type": "registry:file",
          "path": "widgets.css",
          "target": "@components/styles/pxl/widgets.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/widgets.css\"": {}
      },
      "cssVars": {
        "theme": {
          "aspect-widget-sm": "1/1",
          "aspect-widget-md": "86/41",
          "aspect-widget-lg": "1/1",
          "aspect-widget-xl": "43/22",
          "container-7xs": "8rem",
          "container-6xs": "10rem",
          "container-5xs": "12rem",
          "container-4xs": "14rem",
          "container-widget-md": "calc(var(--spacing) * 41)",
          "container-widget-xl": "calc(var(--spacing) * 86)",
          "widget-width-sm": "calc(var(--spacing) * 41)",
          "widget-height-sm": "calc(var(--spacing) * 41)",
          "widget-width-md": "calc(var(--spacing) * 86)",
          "widget-height-md": "calc(var(--spacing) * 41)",
          "widget-width-lg": "calc(var(--spacing) * 86)",
          "widget-height-lg": "calc(var(--spacing) * 86)",
          "widget-width-xl": "calc(var(--spacing) * 176)",
          "widget-height-xl": "calc(var(--spacing) * 86)"  
        }
      }
    }
  ]
}