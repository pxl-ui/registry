    {
      "name": "styles-gradients",
      "type": "registry:style",
      "title": "Color Gradients",
      "description": "Predefined gradients inspired by videogame indicators",
      "categories": ["pxl-ui", "styles"],
      "cssVars": {
        "theme": {
          "background-image-chrome": "linear gradient(to bottom, var(--color-white), var(--color-gray-400), var(--color-gray-300))",
          "background-image-cryo": "linear gradient(to bottom, var(--color-white), var(--color-cyan-300), var(--color-blue-600))",
          "background-image-fire": "linear gradient(to bottom, var(--color-yellow-300), var(--color-orange-500), var(--color-red-600))",
          "background-image-loot": "linear gradient(to bottom, var(--color-yellow-300), var(--color-orange-400), var(--color-yellow-700))",
          "background-image-plasma": "linear gradient(to bottom right, var(--color-fuchsia-500), var(--color-purple-600), var(--color-cyan-400))",
          "background-image-toxic": "linear gradient(to bottom right, var(--color-green-200), var(--color-green-400), var(--color-green-800))",
          "background-image-shadow": "linear gradient(to bottom right, var(--color-purple-300), var(--color-purple-700), var(--color-purple-950))",
          "background-image-synthwave": "linear gradient(to bottom, var(--color-pink-300), var(--color-pink-500), var(--color-orange-400), var(--color-yellow-300))"
        }
      }
