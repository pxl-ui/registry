    {
      "name": "styles-animations",
      "type": "registry:style",
      "title": "Animation Styles",
      "description": "Keyframe based CSS animations",
      "categories": ["pxl-ui", "styles", "animations"],
      "files": [
        {
          "type": "registry:file",
          "path": "animations.css",
          "target": "@components/styles/pxl/animations.css"
        }
      ],
      "css": {
        "@import \"@/components/styles/pxl/animations.css\"": {}
      },
      "cssVars": {
        "theme": {
          "animate-blink": "blink var(--tw-duration, 1s) steps(1) infinite",
          "animate-marquee": "marquee var(--tw-duration, 6s) ease-in-out infinite alternate",
          "animate-shine": "shine var(--tw-duration, 1s) ease-in-out infinite"
        }
      }
    },
    {
